# Serper API 密钥（Google 搜索）- https://serper.dev
SERPER_API_KEY=your-serper-api-key

# 可选的、由操作者指定的 Serper 兼容 API 基础 URL，不包含 /search 或 /images。
# 配置的 API 密钥会通过 X-API-KEY 发送到此主机；请使用可信的服务提供方。
SERPER_BASE_URL=https://google.serper.dev

# Serply API 密钥（Google 搜索、新闻和学术搜索）- https://serply.io
SERPLY_API_KEY=your-serply-api-key

# TAVILY API 密钥
TAVILY_API_KEY=your-tavily-api-key

# 可选的 Webz.io 新闻搜索密钥（在 make setup 中选择 Webz）
# WEBZ_API_KEY=your-webz-api-key

# Jina API 密钥
JINA_API_KEY=your-jina-api-key

# InfoQuest API 密钥
INFOQUEST_API_KEY=your-infoquest-api-key

# Sofya API 密钥（网页搜索与抓取）- https://sofya.co
SOFYA_API_KEY=your-sofya-api-key

# Unbrowse API 密钥（网页抓取）- https://unbrowse.ai/app
UNBROWSE_API_KEY=your-unbrowse-api-key

# Metaso API 密钥（网页搜索与抓取）- https://metaso.cn
METASO_API_KEY=your-metaso-api-key

# 用于跨域或端口转发部署的浏览器 CORS 允许列表（以逗号分隔的完整源地址）。
# 使用统一的 nginx 入口时请留空，例如 http://localhost:2026。
# GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# nginx 入口端口监听的主机接口，适用于 Docker 部署栈，
# 也适用于本地 `make dev` / `make start`；
# Gateway 和前端始终绑定到 loopback。
# 默认值为 127.0.0.1（仅 loopback），符合 README.md 中记录的
# 本地可信环境部署模式——agent 可以执行命令。
# 仅当主机受您自己的 TLS/身份验证入口或防火墙保护，
# 并且已完成首次运行配置后，才设置为 0.0.0.0，使其可被访问。
# 本地运行时可填写 IPv4 地址、IPv6 地址或主机名。
# BIND_HOST=0.0.0.0
# PORT=2026

# Gateway 在按客户端统计登录失败次数时信任其 X-Real-IP 的代理
# （以逗号分隔的 IP、CIDR 或主机名；主机名每 10 秒重新解析一次）。Docker 部署栈
# 默认使用自带的 `nginx` 服务；若未使用该服务，所有浏览器登录请求都会共用 nginx 的
# 地址，因此任何人输错 5 次密码都会导致所有人被锁定。
# 若使用您自己的前置入口，nginx 看到的会是该代理的地址：
# 还需为其配置 nginx 的 real_ip 模块。
# 在 Docker 之外，未设置或设为空表示直连模式：忽略 X-Real-IP。
# 在 Docker 部署栈中，空值也会回退为 `nginx`，
# 因为所有浏览器请求都会经过它。
# AUTH_TRUSTED_PROXIES=nginx

# 可选配置：
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# OPENVIKING_API_KEY=your-openviking-user-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI 兼容，参见 https://novita.ai
# MINIMAX_API_KEY=your-minimax-api-key  # OpenAI 兼容，参见 https://platform.minimax.io
# OPPER_API_KEY=your-opper-api-key  # OpenAI 兼容，参见 https://opper.ai
# OpenAI 兼容的图像 API（供 image-generation skill 使用）
# IMAGE_GENERATION_PROVIDER=openai  # 也接受 openai-compatible
# IMAGE_GENERATION_API_KEY=your-image-generation-api-key
# IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1
# IMAGE_GENERATION_MODEL=gpt-image-2.5-flare
# IMAGE_GENERATION_SIZE=1536x1024
# STEPFUN_API_KEY=your-stepfun-api-key  # OpenAI 兼容，参见 https://platform.stepfun.com
# VLLM_API_KEY=your-vllm-api-key  # OpenAI 兼容

# E2B 云端沙箱 API 密钥——仅使用 E2BSandboxProvider 时必需。
# 请在 https://e2b.dev/dashboard 注册
# E2B_API_KEY=your-e2b-api-key
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# DISCORD_BOT_TOKEN=your-discord-bot-token

# 启用 LangSmith，以监控和调试 LLM 调用、agent 运行及工具执行。
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-langsmith-project

# GitHub API 令牌
# GITHUB_TOKEN=your-github-token

# 数据库（仅当 config.yaml 中 database.backend: postgres 时需要）
# DATABASE_URL=postgresql://deerflow:password@localhost:5432/deerflow
#
# WECOM_BOT_ID=your-wecom-bot-id
# WECOM_BOT_SECRET=your-wecom-bot-secret
# DINGTALK_CLIENT_ID=your-dingtalk-client-id
# DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret

# 设置为 "false" 可在生产环境中禁用 Swagger UI、ReDoc 和 OpenAPI schema
# GATEWAY_ENABLE_DOCS=false

# 嵌入式 DeerFlowClientPool：构造函数显式传参优先；未设置或留空时使用以下默认值。
# 在建池时读取，修改后需重新建池；这些限制适用于单个池。
# 实例数量必须为正整数。
DEER_FLOW_CLIENT_POOL_SIZE=4
# 等待空闲实例的秒数：非负数，0 表示立即尝试，none 表示无限等待（不限制模型执行时间）。
DEER_FLOW_CLIENT_POOL_ACQUIRE_TIMEOUT=none
# 最大排队人数：非负整数，0 表示不排队，none 表示不限制人数。
DEER_FLOW_CLIENT_POOL_MAX_WAITERS=100

# 多 worker 部署共用的 Gateway 内部身份验证令牌。
# `make up` 会使用此处设置的值（与 BETTER_AUTH_SECRET 相同）；若未设置，则会生成一个
# 并保存到 DEER_FLOW_HOME；若 Gateway worker 也通过内置部署脚本之外的方式运行，
# 请手动设置。
# DEER_FLOW_INTERNAL_AUTH_TOKEN=your-shared-internal-token

# 用于加密存储凭据的静态加密密钥（Fernet 密钥）。可用逗号分隔多个密钥以便轮换：
# 第一个密钥用于加密，所有密钥均可用于解密。未设置时，单实例会生成
# DEER_FLOW_HOME/.credentials_key（`make up` 会持久化同一个文件）；未共享 DEER_FLOW_HOME
# 的多个实例必须设置相同的值。
# 请备份此密钥：丢失后，已存储的凭据将无法读取。生成命令：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEER_FLOW_CREDENTIALS_KEY=your-fernet-key

# 用于沙箱身份验证的 Provisioner API 密钥（仅在使用 provisioner/K8s 沙箱模式时必需）。
# provisioner 容器和 config.yaml 中的 sandbox.provisioner_api_key 必须设置相同的值。
# 生成命令：openssl rand -hex 32
# PROVISIONER_API_KEY=your-provisioner-api-key

# ── 前端 SSR → Gateway 连接配置 ───────────────────────────────────────────────
# Next.js 服务端在 SSR 期间使用这些配置访问 Gateway（身份验证检查、
# /api/* 重写）。默认值为与 `make dev` 和 `make start` 匹配的 localhost 地址，
# 因此大多数本地用户无需设置。
#
# 仅当 Gateway 不在 localhost:8001 时覆盖（例如前端和 Gateway 运行在不同主机，
# 容器使用服务别名，或 Gateway 使用其他端口）。
# docker-compose 已设置这些值。
# DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://localhost:8001
# DEER_FLOW_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:2026

# ── 将 Claude Code / Codex CLI 订阅用作模型提供方（可选）──────────────────────
# 如果配置的 ClaudeChatModel / Codex 模型提供方（或 ACP agent）会复用 CLI 订阅登录，
# 建议通过 env 传递令牌，而不是将整个 ~/.claude / ~/.codex
# 绑定挂载到容器中。
# Gateway 凭据加载器会优先读取这些环境变量，因此无需挂载目录。
#   CLAUDE_CODE_CREDENTIALS_PATH 指向单个 .credentials.json（Claude）文件，
#   而不是整个目录。对于需要完整 CLI 配置的适配器，可选择使用
#   docker-compose.cli-auth.yaml 挂载目录作为备用方案。
#   ACP 适配器通常使用自己的 env API 密钥（例如 ANTHROPIC_API_KEY），因此
#   完全无需挂载——请查阅适配器文档。另请参阅 SECURITY.md。
# CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
# ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token
# CLAUDE_CODE_CREDENTIALS_PATH=/path/to/.claude/.credentials.json
# CODEX_AUTH_PATH=/path/to/codex/auth.json
